---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/global.css';

export interface Props {
  title?: string;
  activePage?: string;
}

const { title, activePage = 'home' } = Astro.props;

// Read profile dynamically server-side
const profile = JSON.parse(fs.readFileSync(path.resolve('src/data/profile.json'), 'utf-8'));

// Get language setting from cookie (default 'id')
const lang = Astro.cookies.get('lang')?.value === 'en' ? 'en' : 'id';

// Static text translations dictionary
const t = {
  id: {
    navHome: "Beranda",
    navAbout: "Tentang",
    navSkills: "Keterampilan",
    navProjects: "Proyek",
    navPublications: "Publikasi",
    navCertificates: "Sertifikat",
    navBlog: "Blog",
    navContact: "Kontak",
    downloadCV: "Unduh CV (PDF)"
  },
  en: {
    navHome: "Home",
    navAbout: "About",
    navSkills: "Skills",
    navProjects: "Projects",
    navPublications: "Publications",
    navCertificates: "Certificates",
    navBlog: "Blog",
    navContact: "Contact",
    downloadCV: "Download CV (PDF)"
  }
}[lang];

function getField(item: any, field: string) {
  if (lang === 'en') {
    return item[`${field}_en`] || item[field] || '';
  }
  return item[field] || '';
}

const defaultTitle = `${profile.name} - ${getField(profile, 'role')}`;
const pageTitle = title ? `${title} | ${profile.name}` : defaultTitle;
---

<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={profile.faviconUrl || "/favicon.ico"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>

    <!-- SEO & Open Graph Meta Tags -->
    <meta name="description" content={getField(profile, 'description')} />
    
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={getField(profile, 'description')} />
    <meta property="og:image" content={new URL(profile.ogImageUrl || "/assets/img/foto-putra.jpeg", Astro.url).href} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={getField(profile, 'description')} />
    <meta name="twitter:image" content={new URL(profile.ogImageUrl || "/assets/img/foto-putra.jpeg", Astro.url).href} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
    <!-- Sync theme initialization to prevent flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>

  <body class="bg-white dark:bg-slate-950 text-slate-900 dark:text-slate-100 transition-colors duration-300 selection:bg-indigo-500 selection:text-white flex flex-col min-h-screen">

    <!-- 1. NAVBAR -->
    <nav class="fixed top-0 left-0 w-full h-16 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 flex items-center transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full flex items-center justify-between">
        <a href="/" class="text-xl font-extrabold tracking-tight">
          <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 text-transparent bg-clip-text">{profile.name.split(' ')[0]}</span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/" class={`text-sm font-semibold transition-colors ${activePage === 'home' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navHome}</a>
          <a href="/#about" class={`text-sm font-semibold transition-colors ${activePage === 'about' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navAbout}</a>
          <a href="/#skills" class={`text-sm font-semibold transition-colors ${activePage === 'skills' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navSkills}</a>
          <a href="/projects" class={`text-sm font-semibold transition-colors ${activePage === 'projects' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navProjects}</a>
          <a href="/publications" class={`text-sm font-semibold transition-colors ${activePage === 'publications' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navPublications}</a>
          <a href="/certificates" class={`text-sm font-semibold transition-colors ${activePage === 'certificates' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navCertificates}</a>
          <a href="/blog" class={`text-sm font-semibold transition-colors ${activePage === 'blog' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navBlog}</a>
          <a href="/#contact" class={`text-sm font-semibold transition-colors ${activePage === 'contact' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350 hover:text-indigo-600 dark:hover:text-indigo-400'}`}>{t.navContact}</a>
        </div>

        <div class="hidden md:flex items-center gap-3">
          <!-- Light/Dark Toggler -->
          <button id="theme-toggle" class="w-10 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 flex items-center justify-center cursor-pointer hover:text-indigo-600 hover:border-indigo-500 dark:hover:text-indigo-400 dark:hover:border-indigo-400 transition-all shadow-sm" aria-label="Toggle Theme">
            <i class="fas fa-sun hidden dark:inline-block"></i>
            <i class="fas fa-moon inline-block dark:hidden"></i>
          </button>

          <!-- Language Toggler -->
          <button id="lang-toggle" class="flex items-center gap-1.5 px-3.5 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-400 text-xs font-bold cursor-pointer hover:text-indigo-600 hover:border-indigo-500 dark:hover:text-indigo-400 dark:hover:border-indigo-400 transition-all shadow-sm" aria-label="Switch Language">
            <i class="fas fa-globe text-[11px] text-slate-400"></i>
            <span>{lang === 'en' ? 'EN' : 'ID'}</span>
          </button>
          
          <a href={profile.resumeUrl} target="_blank" class="flex items-center justify-center px-4 h-10 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all shadow-md shadow-indigo-600/10 hover:shadow-indigo-600/20 active:scale-[0.98]">
            {t.downloadCV}
          </a>
        </div>

        <!-- Mobile controls -->
        <div class="flex items-center gap-2 md:hidden">
          <button id="theme-toggle-mobile" class="w-9 h-9 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 flex items-center justify-center" aria-label="Toggle Theme">
            <i class="fas fa-sun hidden dark:inline-block"></i>
            <i class="fas fa-moon inline-block dark:hidden"></i>
          </button>

          <button id="lang-toggle-mobile" class="flex items-center gap-1 px-2.5 h-9 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-550 text-xs font-bold" aria-label="Switch Language">
            <i class="fas fa-globe text-[10px] text-slate-400"></i>
            <span>{lang === 'en' ? 'EN' : 'ID'}</span>
          </button>
          
          <button id="menu-btn" class="text-slate-600 dark:text-slate-300 w-8 h-8 flex items-center justify-center cursor-pointer" aria-label="Toggle Menu">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden absolute top-16 left-0 w-full bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 px-6 py-5 flex-col gap-4 shadow-xl z-40 transition-all duration-300">
        <a href="/" class={`text-sm font-semibold ${activePage === 'home' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350'}`}>{t.navHome}</a>
        <a href="/#about" class={`text-sm font-semibold ${activePage === 'about' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-350'}`}>{t.navAbout}</a>
        <a href="/#skills" class={`text-sm font-semibold ${activePage === 'skills' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navSkills}</a>
        <a href="/projects" class={`text-sm font-semibold ${activePage === 'projects' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navProjects}</a>
        <a href="/publications" class={`text-sm font-semibold ${activePage === 'publications' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navPublications}</a>
        <a href="/certificates" class={`text-sm font-semibold ${activePage === 'certificates' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navCertificates}</a>
        <a href="/blog" class={`text-sm font-semibold ${activePage === 'blog' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navBlog}</a>
        <a href="/#contact" class={`text-sm font-semibold ${activePage === 'contact' ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-600 dark:text-slate-300'}`}>{t.navContact}</a>
        <a href={profile.resumeUrl} target="_blank" class="flex items-center justify-center p-3 rounded-xl bg-indigo-600 text-white text-sm font-bold text-center">
          {t.downloadCV}
        </a>
      </div>
    </nav>

    <main class="flex-grow pt-16">
      <slot />
    </main>

    <!-- Footer Bawah -->
    <footer class="bg-white dark:bg-slate-950 pt-16 pb-8 border-t border-slate-200/80 dark:border-slate-800/80 transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          
          <!-- Column 1: Brand & Bio -->
          <div class="md:col-span-2">
            <a href="/" class="text-2xl font-extrabold tracking-tight mb-4 inline-block">
              <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 text-transparent bg-clip-text">{profile.name}</span>
            </a>
            <p class="text-slate-550 dark:text-slate-400 text-sm leading-relaxed max-w-sm mb-6">
              {getField(profile, 'description')}
            </p>
            <!-- Social Icons -->
            <div class="flex items-center gap-3">
              {profile.socialLinks?.linkedin && (
                <a href={profile.socialLinks.linkedin} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-linkedin-in text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.github && (
                <a href={profile.socialLinks.github} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-github text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.dicoding && (
                <a href={profile.socialLinks.dicoding} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-goodreads-g text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.instagram && (
                <a href={profile.socialLinks.instagram} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-instagram text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.threads && (
                <a href={profile.socialLinks.threads} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-threads text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.twitter && (
                <a href={profile.socialLinks.twitter} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-x-twitter text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.youtube && (
                <a href={profile.socialLinks.youtube} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-youtube text-sm"></i>
                </a>
              )}
              {profile.socialLinks?.tiktok && (
                <a href={profile.socialLinks.tiktok} target="_blank" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-900 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-500 transition-all">
                  <i class="fab fa-tiktok text-sm"></i>
                </a>
              )}
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-5 uppercase tracking-wider">{lang === 'en' ? 'Quick Links' : 'Tautan Cepat'}</h4>
            <ul class="space-y-3">
              <li><a href="/#about" class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors">{t.navAbout}</a></li>
              <li><a href="/projects" class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors">{t.navProjects}</a></li>
              <li><a href="/publications" class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors">{t.navPublications}</a></li>
              <li><a href="/certificates" class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors">{t.navCertificates}</a></li>
              <li><a href="/blog" class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors">{t.navBlog}</a></li>
            </ul>
          </div>

          <!-- Column 3: Contact Info -->
          <div>
            <h4 class="text-sm font-bold text-slate-900 dark:text-white mb-5 uppercase tracking-wider">{t.navContact}</h4>
            <ul class="space-y-4">
              <li class="flex items-start gap-3">
                <i class="fas fa-envelope text-indigo-500 mt-1"></i>
                <a href={`mailto:${profile.email}`} class="text-slate-550 dark:text-slate-400 hover:text-indigo-600 dark:hover:text-indigo-400 text-sm transition-colors break-all">
                  {profile.email}
                </a>
              </li>
              <li class="flex items-start gap-3">
                <i class="fas fa-map-marker-alt text-indigo-500 mt-1"></i>
                <span class="text-slate-550 dark:text-slate-400 text-sm">
                  {getField(profile, 'location') || 'Medan, Indonesia'}
                </span>
              </li>
              <li>
                <a href={profile.resumeUrl} target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 mt-2 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all shadow-md shadow-indigo-600/20 active:scale-[0.98]">
                  <i class="fas fa-download"></i>
                  {t.downloadCV}
                </a>
              </li>
            </ul>
          </div>

        </div>

        <!-- Bottom Copyright Area -->
        <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col items-center justify-center gap-4 text-center">
          <p class="text-slate-500 dark:text-slate-500 text-xs font-medium">
            &copy; {new Date().getFullYear()} <span class="font-bold text-slate-700 dark:text-slate-300">{profile.name}</span>. All rights reserved.<br/>
            Built with <span class="text-red-500 animate-pulse inline-block mx-1">♥</span> using Astro & Tailwind CSS.
          </p>
          <a href="/admin" class="text-slate-400 dark:text-slate-500 hover:text-indigo-600 dark:hover:text-indigo-400 font-semibold transition-colors text-xs flex items-center gap-1.5">
            <i class="fas fa-lock"></i> Admin Panel
          </a>
        </div>
      </div>
    </footer>

    <!-- Script Interaktif Navbar & Tema/Bahasa Switchers -->
    <script>
      // 1. Mobile Menu Toggle
      const menuBtn = document.getElementById('menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');

      menuBtn?.addEventListener('click', () => {
        if (mobileMenu) {
          mobileMenu.classList.toggle('hidden');
          mobileMenu.classList.toggle('flex');
        }
      });

      // 2. Dark/Light Theme Switching Logic
      const themeToggleBtn = document.getElementById('theme-toggle');
      const themeToggleMobileBtn = document.getElementById('theme-toggle-mobile');

      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        const nextTheme = isDark ? 'dark' : 'light';
        localStorage.setItem('theme', nextTheme);
      }

      themeToggleBtn?.addEventListener('click', toggleTheme);
      themeToggleMobileBtn?.addEventListener('click', toggleTheme);

      // 3. Language Switching Logic (Cookie-based SSR)
      const langToggleBtn = document.getElementById('lang-toggle');
      const langToggleMobileBtn = document.getElementById('lang-toggle-mobile');

      function toggleLanguage() {
        // Read cookies
        const cookies = document.cookie.split('; ').reduce((acc: any, row) => {
          const parts = row.split('=');
          if (parts[0]) acc[parts[0]] = parts[1] || '';
          return acc;
        }, {});
        
        const currentLang = cookies['lang'] || 'id';
        const nextLang = currentLang === 'id' ? 'en' : 'id';
        
        // Write cookie
        document.cookie = `lang=${nextLang}; path=/; max-age=31536000; SameSite=Lax`;
        
        // Reload page to reflect server changes
        window.location.reload();
      }

      langToggleBtn?.addEventListener('click', toggleLanguage);
      langToggleMobileBtn?.addEventListener('click', toggleLanguage);
    </script>
  </body>
</html>

---
import { isAuthenticated } from '../../utils/auth';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

import fs from 'node:fs';
import path from 'node:path';
import AdminLayout from '../../layouts/AdminLayout.astro';

// Load skills categories server-side
import skills from '../../data/skills.json';
---

<AdminLayout title="Kelola Keterampilan" activeTab="skills">
  <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm max-w-xl">
      Kelola klasifikasi keterampilan teknis Anda. Anda dapat menambahkan rumpun keahlian baru dan mendaftarkan item badge di dalamnya dalam Bahasa Indonesia & Inggris.
    </p>
    <button
      id="add-category-btn"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-all shadow-lg shadow-indigo-600/30 cursor-pointer shrink-0"
    >
      <i class="fas fa-plus"></i> Tambah Kategori
    </button>
  </div>

  <!-- Grid Kategori -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="categories-grid">
    {skills.map((category: any) => (
      <div 
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-6 rounded-2xl flex flex-col justify-between shadow-sm dark:shadow-xl"
        data-id={category.id}
        data-category-en={category.category_en || ''}
      >
        <div>
          <h4 class="text-md font-bold text-slate-900 dark:text-white mb-4 pb-2 border-b border-slate-200 dark:border-slate-850 flex flex-col gap-0.5">
            <span class="category-title">{category.category}</span>
            <span class="category-title-en text-xs text-slate-400 dark:text-slate-550 font-semibold">{category.category_en || ''}</span>
          </h4>
          
          <div class="flex flex-wrap gap-2 mb-6 category-badges">
            {category.items?.map((item: string) => (
              <span class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-850 text-slate-700 dark:text-slate-300 text-xs font-semibold">
                {item}
              </span>
            ))}
          </div>
        </div>

        <div class="flex items-center gap-2 pt-4 border-t border-slate-200 dark:border-slate-850">
          <button
            class="edit-btn flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-indigo-650 dark:hover:text-indigo-400 text-xs font-bold transition-all cursor-pointer"
            data-id={category.id}
          >
            <i class="fas fa-edit mr-1"></i> Edit
          </button>
          <button
            class="delete-btn py-2.5 px-3.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-red-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-red-500/5 text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 text-xs font-bold transition-all cursor-pointer"
            data-id={category.id}
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal Dialog (Hidden by Default) -->
  <div 
    id="category-modal" 
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
  >
    <div class="w-full max-w-lg bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-2xl relative">
      <h3 id="modal-title" class="text-md font-bold text-slate-900 dark:text-white mb-6 pb-2 border-b border-slate-200 dark:border-slate-800 flex items-center gap-2">
        <i class="fas fa-edit text-indigo-600 dark:text-indigo-400"></i>
        Edit Kategori Keterampilan
      </h3>

      <form id="modal-form" class="space-y-5">
        <input type="hidden" id="modal-category-id" />
        
        <div>
          <label for="modal-category-title" class="block text-xs font-bold text-slate-500 dark:text-slate-450 mb-2">Nama Kategori (ID)</label>
          <input
            id="modal-category-title"
            type="text"
            required
            placeholder="Contoh: Rumpun Backend"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div>
          <label for="modal-category-title-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Nama Kategori (EN)</label>
          <input
            id="modal-category-title-en"
            type="text"
            required
            placeholder="Contoh: Backend Stack"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div>
          <label for="modal-category-items" class="block text-xs font-bold text-slate-500 dark:text-slate-450 mb-2">
            Item Keterampilan (Pisahkan dengan Koma)
          </label>
          <textarea
            id="modal-category-items"
            required
            rows="4"
            placeholder="Contoh: PHP, Laravel, Node.js, Express"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm resize-none focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          ></textarea>
          <p class="text-[10px] text-slate-400 dark:text-slate-500 mt-1.5 leading-relaxed">
            * Setiap item dipisah tanda koma `,`. Spasi berlebih di awal/akhir kata akan dihapus otomatis.
          </p>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Foto / Ikon Kategori (Opsional)</label>
          <div class="flex items-center gap-3">
            <input
              id="modal-category-image"
              type="text"
              placeholder="/assets/img/nama-kategori.png atau URL"
              class="flex-1 px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
            <input type="file" id="skill-image-file-input" accept="image/*" class="hidden" />
            <button type="button" id="upload-skill-image-btn" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer">
              <i class="fas fa-upload"></i> Upload
            </button>
            <img id="skill-image-preview" src="" alt="" class="w-12 h-12 object-cover rounded-xl border border-slate-200 dark:border-slate-850 hidden" />
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
          <button
            type="button"
            id="modal-cancel-btn"
            class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold transition-all cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer"
          >
            Simpan Kategori
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let categoriesList = [] as any[];
    const grid = document.getElementById('categories-grid');
    
    function getInitialData() {
      const cards = document.querySelectorAll('#categories-grid > div');
      const list = [] as any[];
      cards.forEach(card => {
        const id = card.getAttribute('data-id');
        const categoryEn = card.getAttribute('data-category-en');
        const titleEl = card.querySelector('.category-title');
        const badges = card.querySelectorAll('.category-badges > span');
        const items = Array.from(badges).map(b => (b as HTMLElement).innerText.trim());
        
        list.push({
          id: id,
          category: titleEl ? (titleEl as HTMLElement).innerText.trim() : '',
          category_en: categoryEn || '',
          items: items
        });
      });
      categoriesList = list;
    }

    getInitialData();

    // Modal elements
    const modal = document.getElementById('category-modal');
    const modalForm = document.getElementById('modal-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    const modalCategoryId = document.getElementById('modal-category-id') as HTMLInputElement;
    const modalCategoryTitle = document.getElementById('modal-category-title') as HTMLInputElement;
    const modalCategoryTitleEn = document.getElementById('modal-category-title-en') as HTMLInputElement;
    const modalCategoryItems = document.getElementById('modal-category-items') as HTMLTextAreaElement;
    const modalCategoryImage = document.getElementById('modal-category-image') as HTMLInputElement;

    function showModal(isEdit = false, categoryData: any = null) {
      if (!modal) return;
      
      if (isEdit && categoryData) {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-edit text-indigo-500"></i> Edit Kategori';
        modalCategoryId.value = categoryData.id;
        modalCategoryTitle.value = categoryData.category;
        modalCategoryTitleEn.value = categoryData.category_en || '';
        modalCategoryItems.value = categoryData.items.join(', ');
        modalCategoryImage.value = (categoryData as any).image || '';
        const prevImg = document.getElementById('skill-image-preview') as HTMLImageElement;
        if ((categoryData as any).image) { prevImg.src = (categoryData as any).image; prevImg.classList.remove('hidden'); } else { prevImg.classList.add('hidden'); }
      } else {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-plus text-indigo-500"></i> Tambah Kategori Baru';
        modalCategoryId.value = '';
        modalCategoryTitle.value = '';
        modalCategoryTitleEn.value = '';
        modalCategoryItems.value = '';
        modalCategoryImage.value = '';
        const prevImg2 = document.getElementById('skill-image-preview') as HTMLImageElement;
        prevImg2.classList.add('hidden');
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.add('opacity-100');
      }, 10);
    }

    function hideModal() {
      if (!modal) return;
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    document.getElementById('add-category-btn')?.addEventListener('click', () => {
      showModal(false);
    });

    document.getElementById('modal-cancel-btn')?.addEventListener('click', () => {
      hideModal();
    });

    grid?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      
      const editBtn = target.closest('.edit-btn');
      if (editBtn) {
        const id = editBtn.getAttribute('data-id');
        const cat = categoriesList.find(c => c.id === id);
        if (cat) {
          showModal(true, cat);
        }
        return;
      }

      const deleteBtn = target.closest('.delete-btn');
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-id');
        if (confirm('Apakah Anda yakin ingin menghapus kategori beserta seluruh isinya?')) {
          deleteCategory(id);
        }
        return;
      }
    });

    modalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = modalCategoryId.value;
      const title = modalCategoryTitle.value.trim();
      const titleEn = modalCategoryTitleEn.value.trim();
      const itemsString = modalCategoryItems.value;
      
      const items = itemsString
        .split(',')
        .map(i => i.trim())
        .filter(i => i.length > 0);

      if (id) {
        const index = categoriesList.findIndex(c => c.id === id);
        if (index !== -1) {
          categoriesList[index].category = title;
          categoriesList[index].category_en = titleEn;
          categoriesList[index].items = items;
        }
      } else {
        const newCat = {
          id: Date.now().toString(),
          category: title,
          category_en: titleEn,
          items: items
        };
        categoriesList.push(newCat);
      }

      await saveToServer();
      hideModal();
    });

    async function deleteCategory(id: string | null) {
      if (!id) return;
      categoriesList = categoriesList.filter(c => c.id !== id);
      await saveToServer();
    }

    async function saveToServer() {
      try {
        const res = await fetch('/api/skills', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(categoriesList)
        });

        if (res.ok) {
          (window as any).showToast('Keterampilan berhasil diperbarui!', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          (window as any).showToast('Gagal memperbarui keterampilan!', 'error');
        }
      } catch (err) {
        console.error(err);
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    }

    // ── Upload foto kategori keterampilan ──
    const uploadSkillImageBtn = document.getElementById('upload-skill-image-btn');
    const skillImageFileInput = document.getElementById('skill-image-file-input') as HTMLInputElement;
    uploadSkillImageBtn?.addEventListener('click', () => skillImageFileInput?.click());
    skillImageFileInput?.addEventListener('change', async () => {
      const file = skillImageFileInput.files?.[0];
      if (!file) return;
      const id = modalCategoryId.value;
      if (!id) {
        (window as any).showToast('Simpan kategori terlebih dahulu sebelum mengunggah gambar!', 'error');
        return;
      }
      const form = new FormData();
      form.append('skillImage', file);
      form.append('skillId', id);
      try {
        const res = await fetch('/api/upload-assets', { method: 'POST', body: form });
        const data = await res.json();
        if (data.skillImageUrl) {
          modalCategoryImage.value = data.skillImageUrl;
          const preview = document.getElementById('skill-image-preview') as HTMLImageElement;
          preview.src = data.skillImageUrl;
          preview.classList.remove('hidden');
          (window as any).showToast('Foto kategori berhasil diunggah!', 'success');
        } else {
          (window as any).showToast(data.error || 'Gagal mengunggah foto!', 'error');
        }
      } catch (err) {
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    });
  </script>
</AdminLayout>

---
import { isAuthenticated } from '../../utils/auth';
import '../../styles/global.css';

if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin');
}
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login Admin - Portofolio</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
  </head>
  <body class="bg-slate-950 text-slate-200 antialiased min-h-screen flex items-center justify-center p-4">
    
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-8 relative overflow-hidden shadow-2xl shadow-indigo-500/5">
      <!-- Glow effect -->
      <div class="absolute -top-40 -left-40 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 -right-40 w-80 h-80 bg-violet-500/10 rounded-full blur-3xl"></div>

      <div class="relative flex flex-col items-center">
        <!-- Shield icon -->
        <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 text-2xl mb-6 shadow-lg shadow-indigo-500/10">
          <i class="fas fa-user-shield"></i>
        </div>

        <h1 class="text-2xl font-bold text-white mb-2">Admin Login</h1>
        <p class="text-slate-400 text-sm text-center mb-8">Masukkan kode akses admin untuk mengelola portofolio Anda.</p>

        <form id="login-form" class="w-full space-y-6">
          <div>
            <label for="passcode" class="block text-xs font-semibold text-slate-400 mb-2">Kode Akses (Passcode)</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">
                <i class="fas fa-lock"></i>
              </span>
              <input
                id="passcode"
                type="password"
                required
                placeholder="Masukkan passcode"
                class="w-full pl-11 pr-11 py-3.5 rounded-xl bg-slate-950 border border-slate-800 text-white text-sm placeholder:text-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors"
              />
              <button
                type="button"
                id="toggle-password"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300"
              >
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <div id="error-msg" class="hidden p-3.5 rounded-xl border border-red-500/20 bg-red-500/5 text-red-400 text-xs font-medium flex items-center gap-2">
            <i class="fas fa-exclamation-circle"></i>
            <span id="error-text"></span>
          </div>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-sm transition-all shadow-lg shadow-indigo-500/20 active:scale-[0.98] cursor-pointer"
          >
            <i class="fas fa-sign-in-alt"></i>
            Masuk ke Dashboard
          </button>
        </form>

        <a href="/" class="mt-8 text-xs text-slate-500 hover:text-slate-300 transition-colors">
          <i class="fas fa-arrow-left mr-1.5"></i>Kembali ke Portofolio
        </a>
      </div>
    </div>

    <script>
      const form = document.getElementById('login-form');
      const passcodeVal = document.getElementById('passcode') as HTMLInputElement;
      const errorMsg = document.getElementById('error-msg');
      const errorText = document.getElementById('error-text');
      const togglePassword = document.getElementById('toggle-password');

      togglePassword?.addEventListener('click', () => {
        const type = passcodeVal.getAttribute('type') === 'password' ? 'text' : 'password';
        passcodeVal.setAttribute('type', type);
        const icon = togglePassword.querySelector('i');
        if (icon) {
          icon.className = type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
        }
      });

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg?.classList.add('hidden');

        try {
          const res = await fetch('/api/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ passcode: passcodeVal.value })
          });
          
          const data = await res.json();
          if (res.ok) {
            window.location.href = '/admin';
          } else {
            if (errorMsg && errorText) {
              errorText.innerText = data.error || 'Passcode salah!';
              errorMsg.classList.remove('hidden');
            }
          }
        } catch (err) {
          console.error(err);
          if (errorMsg && errorText) {
            errorText.innerText = 'Terjadi kesalahan jaringan.';
            errorMsg.classList.remove('hidden');
          }
        }
      });
    </script>
  </body>
</html>

---
import { isAuthenticated } from '../../utils/auth';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

import fs from 'node:fs';
import path from 'node:path';
import AdminLayout from '../../layouts/AdminLayout.astro';

// Load education server-side
import educationData from '../../data/education.json';
const education = educationData || [];
---

<AdminLayout title="Kelola Pendidikan" activeTab="education">
  <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm max-w-xl">
      Kelola riwayat pendidikan formal atau non-formal Anda. Data ini akan ditampilkan langsung di halaman utama.
    </p>
    <button
      id="add-education-btn"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-all shadow-lg shadow-indigo-600/30 cursor-pointer shrink-0"
    >
      <i class="fas fa-plus"></i> Tambah Pendidikan
    </button>
  </div>

  <!-- Grid Pendidikan -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="education-grid">
    {education.map((edu: any) => (
      <div 
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl p-5 flex flex-col justify-between shadow-sm dark:shadow-xl group"
        data-id={edu.id}
      >
        <div class="flex items-start gap-4 mb-4">
          <div class="w-16 h-16 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shrink-0 overflow-hidden flex items-center justify-center p-1">
            <img 
              src={edu.logo} 
              alt={edu.institution}
              class="w-full h-full object-contain"
              onerror="this.onerror=null;this.src='https://placehold.co/100x100/020617/818cf8?text=Edu';"
            />
          </div>
          <div class="flex-1">
            <h4 class="text-md font-bold text-slate-900 dark:text-white mb-1 leading-snug">{edu.institution}</h4>
            <p class="text-sm font-semibold text-indigo-600 dark:text-indigo-400 mb-1">{edu.degree}</p>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
              <i class="fas fa-calendar-alt mr-1"></i> {edu.startYear} - {edu.endYear || 'Sekarang'}
            </span>
          </div>
        </div>

        <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed mb-5 line-clamp-3">
          {edu.description}
        </p>

        <div class="flex items-center gap-2 pt-4 border-t border-slate-200/80 dark:border-slate-850/80 mt-auto">
          <button
            class="edit-btn flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-indigo-650 dark:hover:text-indigo-400 text-xs font-bold transition-all cursor-pointer"
            data-id={edu.id}
          >
            <i class="fas fa-edit mr-1"></i> Edit
          </button>
          <button
            class="delete-btn py-2.5 px-3.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-red-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-red-550/5 text-slate-400 dark:text-slate-500 hover:text-red-650 dark:hover:text-red-400 text-xs font-bold transition-all cursor-pointer"
            data-id={edu.id}
          >
            <i class="fas fa-trash-alt"></i>
          </button>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal Dialog -->
  <div 
    id="education-modal" 
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
  >
    <div class="w-full max-w-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <h3 id="modal-title" class="text-md font-bold text-slate-900 dark:text-white mb-6 pb-2 border-b border-slate-200 dark:border-slate-800 flex items-center gap-2">
        <i class="fas fa-graduation-cap text-indigo-600 dark:text-indigo-400"></i>
        Edit Pendidikan
      </h3>

      <form id="modal-form" class="space-y-5">
        <input type="hidden" id="modal-edu-id" />
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="modal-edu-inst" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Institusi/Kampus (ID)</label>
            <input
              id="modal-edu-inst"
              type="text"
              required
              placeholder="Contoh: Universitas Sumatera Utara"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
          <div>
            <label for="modal-edu-inst-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Institusi/Kampus (EN)</label>
            <input
              id="modal-edu-inst-en"
              type="text"
              required
              placeholder="Example: University of Sumatera Utara"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="modal-edu-degree" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Gelar/Jurusan (ID)</label>
            <input
              id="modal-edu-degree"
              type="text"
              required
              placeholder="Contoh: S1 Teknologi Informasi"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
          <div>
            <label for="modal-edu-degree-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Gelar/Jurusan (EN)</label>
            <input
              id="modal-edu-degree-en"
              type="text"
              required
              placeholder="Example: BSc Information Technology"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label for="modal-edu-start" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tahun Mulai</label>
            <input
              id="modal-edu-start"
              type="text"
              required
              placeholder="Contoh: 2020"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
          <div>
            <label for="modal-edu-end" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tahun Selesai (Kosongkan jika aktif)</label>
            <input
              id="modal-edu-end"
              type="text"
              placeholder="Contoh: 2024"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
        </div>

        <div>
          <label for="modal-edu-desc" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Deskripsi/Catatan (ID)</label>
          <textarea
            id="modal-edu-desc"
            rows="3"
            placeholder="Aktivitas, IPK, atau prestasi singkat..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm resize-none focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          ></textarea>
        </div>

        <div>
          <label for="modal-edu-desc-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Deskripsi/Catatan (EN)</label>
          <textarea
            id="modal-edu-desc-en"
            rows="3"
            placeholder="Activities, GPA, or brief achievements..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm resize-none focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Logo Institusi</label>
          <div class="flex items-center gap-3">
            <input
              id="modal-edu-logo"
              type="text"
              required
              placeholder="URL logo atau unggah"
              class="flex-1 px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
            <input type="file" id="edu-logo-file-input" accept="image/*" class="hidden" />
            <button type="button" id="upload-edu-logo-btn" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer">
              <i class="fas fa-upload"></i> Upload
            </button>
            <img id="edu-logo-preview" src="" alt="" class="w-12 h-12 object-contain bg-slate-50 rounded border border-slate-200 dark:border-slate-850 hidden" />
          </div>
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
          <button
            type="button"
            id="modal-cancel-btn"
            class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold transition-all cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer"
          >
            Simpan Pendidikan
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let educationList = [] as any[];

    async function loadEducation() {
      try {
        const res = await fetch('/api/education');
        if (res.ok) {
          educationList = await res.json();
        }
      } catch (e) {
        console.error('Error loading education list', e);
      }
    }

    loadEducation();

    const grid = document.getElementById('education-grid');
    const modal = document.getElementById('education-modal');
    const modalForm = document.getElementById('modal-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    
    const modalId = document.getElementById('modal-edu-id') as HTMLInputElement;
    const modalInst = document.getElementById('modal-edu-inst') as HTMLInputElement;
    const modalInstEn = document.getElementById('modal-edu-inst-en') as HTMLInputElement;
    const modalDegree = document.getElementById('modal-edu-degree') as HTMLInputElement;
    const modalDegreeEn = document.getElementById('modal-edu-degree-en') as HTMLInputElement;
    const modalStart = document.getElementById('modal-edu-start') as HTMLInputElement;
    const modalEnd = document.getElementById('modal-edu-end') as HTMLInputElement;
    const modalDesc = document.getElementById('modal-edu-desc') as HTMLTextAreaElement;
    const modalDescEn = document.getElementById('modal-edu-desc-en') as HTMLTextAreaElement;
    const modalLogo = document.getElementById('modal-edu-logo') as HTMLInputElement;

    function showModal(isEdit = false, edu: any = null) {
      if (!modal) return;
      
      if (isEdit && edu) {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-edit text-indigo-500"></i> Edit Pendidikan';
        modalId.value = edu.id;
        modalInst.value = edu.institution || '';
        modalInstEn.value = edu.institution_en || '';
        modalDegree.value = edu.degree || '';
        modalDegreeEn.value = edu.degree_en || '';
        modalStart.value = edu.startYear || '';
        modalEnd.value = edu.endYear || '';
        modalDesc.value = edu.description || '';
        modalDescEn.value = edu.description_en || '';
        modalLogo.value = edu.logo || '';
      } else {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-plus text-indigo-500"></i> Tambah Pendidikan Baru';
        modalId.value = '';
        modalInst.value = '';
        modalInstEn.value = '';
        modalDegree.value = '';
        modalDegreeEn.value = '';
        modalStart.value = '';
        modalEnd.value = '';
        modalDesc.value = '';
        modalDescEn.value = '';
        modalLogo.value = 'https://placehold.co/100x100/ffffff/818cf8?text=Logo';
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.add('opacity-100');
      }, 10);
    }

    function hideModal() {
      if (!modal) return;
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    document.getElementById('add-education-btn')?.addEventListener('click', () => {
      showModal(false);
    });

    document.getElementById('modal-cancel-btn')?.addEventListener('click', () => {
      hideModal();
    });

    grid?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      const editBtn = target.closest('.edit-btn');
      if (editBtn) {
        const id = editBtn.getAttribute('data-id');
        const edu = educationList.find(p => p.id === id);
        if (edu) {
          showModal(true, edu);
        }
        return;
      }

      const deleteBtn = target.closest('.delete-btn');
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-id');
        if (confirm('Apakah Anda yakin ingin menghapus pendidikan ini?')) {
          await deleteEducation(id);
        }
        return;
      }
    });

    modalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = modalId.value;
      const payload = {
        id,
        institution: modalInst.value.trim(),
        institution_en: modalInstEn.value.trim(),
        degree: modalDegree.value.trim(),
        degree_en: modalDegreeEn.value.trim(),
        startYear: modalStart.value.trim(),
        endYear: modalEnd.value.trim(),
        description: modalDesc.value.trim(),
        description_en: modalDescEn.value.trim(),
        logo: modalLogo.value.trim()
      };

      try {
        const method = id ? 'PUT' : 'POST';
        const res = await fetch('/api/education', {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          (window as any).showToast(id ? 'Pendidikan diperbarui!' : 'Pendidikan baru ditambahkan!', 'success');
          hideModal();
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          (window as any).showToast('Gagal memproses data!', 'error');
        }
      } catch (err) {
        console.error(err);
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    });

    async function deleteEducation(id: string | null) {
      if (!id) return;
      try {
        const res = await fetch(`/api/education?id=${id}`, {
          method: 'DELETE'
        });

        if (res.ok) {
          (window as any).showToast('Data berhasil dihapus!', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          (window as any).showToast('Gagal menghapus data!', 'error');
        }
      } catch (err) {
        console.error(err);
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    }

    // ── Upload Logo ──
    const uploadBtn = document.getElementById('upload-edu-logo-btn');
    const fileInput = document.getElementById('edu-logo-file-input') as HTMLInputElement;
    uploadBtn?.addEventListener('click', () => fileInput?.click());
    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const id = modalId.value;
      if (!id) {
        (window as any).showToast('Simpan data terlebih dahulu sebelum mengunggah logo!', 'error');
        return;
      }
      const form = new FormData();
      form.append('educationImage', file);
      form.append('educationId', id);
      try {
        const res = await fetch('/api/upload-assets', { method: 'POST', body: form });
        const data = await res.json();
        if (data.educationImageUrl) {
          modalLogo.value = data.educationImageUrl;
          const preview = document.getElementById('edu-logo-preview') as HTMLImageElement;
          preview.src = data.educationImageUrl;
          preview.classList.remove('hidden');
          (window as any).showToast('Logo berhasil diunggah!', 'success');
        } else {
          (window as any).showToast(data.error || 'Gagal mengunggah logo!', 'error');
        }
      } catch (err) {
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    });
  </script>
</AdminLayout>

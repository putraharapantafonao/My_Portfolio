---
import { isAuthenticated } from '../../utils/auth';

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin/login');
}

import fs from 'node:fs';
import path from 'node:path';
import AdminLayout from '../../layouts/AdminLayout.astro';

// Load projects server-side
const projects = JSON.parse(fs.readFileSync(path.resolve('src/data/projects.json'), 'utf-8'));
---

<AdminLayout title="Kelola Proyek Utama" activeTab="projects">
  <div class="mb-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <p class="text-slate-500 dark:text-slate-400 text-sm max-w-xl">
      Daftar proyek rekayasa perangkat lunak Anda. Proyek yang terbit di sini akan langsung dirender di bagian landing page utama dengan versi dwi-bahasa.
    </p>
    <button
      id="add-project-btn"
      class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs transition-all shadow-lg shadow-indigo-600/30 cursor-pointer shrink-0"
    >
      <i class="fas fa-plus"></i> Tambah Proyek Baru
    </button>
  </div>

  <!-- Grid Proyek -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
    {projects.map((proj: any) => (
      <div 
        class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl overflow-hidden flex flex-col justify-between shadow-sm dark:shadow-xl group"
        data-id={proj.id}
      >
        <div class="relative h-40 bg-slate-100 dark:bg-slate-950 overflow-hidden border-b border-slate-200 dark:border-slate-850">
          <img 
            src={proj.image} 
            alt={proj.title}
            class="w-full h-full object-cover opacity-90"
            onerror="this.onerror=null;this.src='https://placehold.co/600x400/020617/818cf8?text=Project';"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/20 to-transparent"></div>
        </div>

        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <h4 class="text-md font-bold text-slate-900 dark:text-white mb-2 project-title leading-snug">{proj.title}</h4>
            <p class="text-slate-500 dark:text-slate-400 text-xs leading-relaxed mb-4 line-clamp-3 project-desc">{proj.description}</p>
            
            <div class="flex flex-wrap gap-1.5 mb-5 project-tags">
              {proj.tags?.map((tag: string) => (
                <span class="px-2 py-0.5 rounded bg-indigo-50 dark:bg-indigo-950/60 border border-indigo-100 dark:border-indigo-900/30 text-[10px] font-bold text-indigo-650 dark:text-indigo-400">
                  {tag}
                </span>
              ))}
            </div>
            
            {proj.link && proj.link !== "#" && (
              <span class="text-[11px] text-slate-400 dark:text-slate-500 font-mono block mb-4 truncate project-link">
                <i class="fas fa-link mr-1"></i> {proj.link}
              </span>
            )}
          </div>

          <div class="flex items-center gap-2 pt-4 border-t border-slate-200/80 dark:border-slate-850/80">
            <button
              class="edit-btn flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-indigo-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-slate-100 dark:hover:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-indigo-650 dark:hover:text-indigo-400 text-xs font-bold transition-all cursor-pointer"
              data-id={proj.id}
            >
              <i class="fas fa-edit mr-1"></i> Edit Proyek
            </button>
            <button
              class="delete-btn py-2.5 px-3.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:border-red-500/30 bg-slate-50 dark:bg-slate-950 hover:bg-red-550/5 text-slate-400 dark:text-slate-500 hover:text-red-650 dark:hover:text-red-400 text-xs font-bold transition-all cursor-pointer"
              data-id={proj.id}
            >
              <i class="fas fa-trash-alt"></i>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Modal Dialog (Hidden by Default) -->
  <div 
    id="project-modal" 
    class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
  >
    <div class="w-full max-w-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
      <h3 id="modal-title" class="text-md font-bold text-slate-900 dark:text-white mb-6 pb-2 border-b border-slate-200 dark:border-slate-800 flex items-center gap-2">
        <i class="fas fa-edit text-indigo-600 dark:text-indigo-400"></i>
        Edit Proyek Utama
      </h3>

      <form id="modal-form" class="space-y-5">
        <input type="hidden" id="modal-project-id" />
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="modal-project-title" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Judul Proyek (ID)</label>
            <input
              id="modal-project-title"
              type="text"
              required
              placeholder="Nama proyek"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
          <div>
            <label for="modal-project-title-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Judul Proyek (EN)</label>
            <input
              id="modal-project-title-en"
              type="text"
              required
              placeholder="Project title"
              class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
          </div>
        </div>
        
        <div>
          <label for="modal-project-date" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Bulan & Tahun Pembuatan <span class="font-normal">(Opsional)</span></label>
          <input
            id="modal-project-date"
            type="month"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>


        <div>
          <label for="modal-project-desc" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Deskripsi Proyek (ID)</label>
          <textarea
            id="modal-project-desc"
            required
            rows="3"
            placeholder="Uraikan detail pekerjaan proyek..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm resize-none focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          ></textarea>
        </div>

        <div>
          <label for="modal-project-desc-en" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Deskripsi Proyek (EN)</label>
          <textarea
            id="modal-project-desc-en"
            required
            rows="3"
            placeholder="Describe the details of the project..."
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm resize-none focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Foto / Gambar Proyek</label>
          <div class="flex items-center gap-3">
            <input
              id="modal-project-image"
              type="text"
              required
              placeholder="/assets/img/nama-file.png atau URL"
              class="flex-1 px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
            />
            <input type="file" id="project-image-file-input" accept="image/*" class="hidden" />
            <button type="button" id="upload-project-image-btn" class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer">
              <i class="fas fa-upload"></i> Upload
            </button>
            <img id="project-image-preview" src="" alt="" class="w-12 h-12 object-cover rounded-xl border border-slate-200 dark:border-slate-850 hidden" />
          </div>
        </div>
        <div>
          <label for="modal-project-fallback" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Link Gambar Cadangan (Fallback)</label>
          <input
            id="modal-project-fallback"
            type="text"
            placeholder="URL gambar cadangan"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div>
          <label for="modal-project-tags" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tag/Teknologi (Pisahkan dengan Koma)</label>
          <input
            id="modal-project-tags"
            type="text"
            required
            placeholder="Contoh: Laravel, Vue.js, Tailwind CSS"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div>
          <label for="modal-project-link" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Tautan Proyek (GitHub) <span class="text-slate-400 font-normal">(Opsional)</span></label>
          <input
            id="modal-project-link"
            type="text"
            placeholder="Contoh: https://github.com/user/repo"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div>
          <label for="modal-project-demo" class="block text-xs font-bold text-slate-500 dark:text-slate-400 mb-2">Live Demo URL <span class="text-slate-400 font-normal">(Opsional)</span></label>
          <input
            id="modal-project-demo"
            type="text"
            placeholder="Contoh: https://my-project-live.com"
            class="w-full px-4 py-3 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white text-sm focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-colors shadow-sm"
          />
        </div>

        <div class="flex justify-end gap-3 pt-4 border-t border-slate-200 dark:border-slate-800">
          <button
            type="button"
            id="modal-cancel-btn"
            class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-bold transition-all cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all cursor-pointer"
          >
            Simpan Proyek
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let projectsList = [] as any[];

    async function loadProjects() {
      try {
        const res = await fetch('/api/projects');
        if (res.ok) {
          projectsList = await res.json();
        }
      } catch (e) {
        console.error('Error loading projects list', e);
      }
    }

    loadProjects();

    const grid = document.getElementById('projects-grid');
    const modal = document.getElementById('project-modal');
    const modalForm = document.getElementById('modal-form') as HTMLFormElement;
    const modalTitle = document.getElementById('modal-title');
    const modalProjectId = document.getElementById('modal-project-id') as HTMLInputElement;
    const modalProjectTitle = document.getElementById('modal-project-title') as HTMLInputElement;
    const modalProjectTitleEn = document.getElementById('modal-project-title-en') as HTMLInputElement;
    const modalProjectDesc = document.getElementById('modal-project-desc') as HTMLTextAreaElement;
    const modalProjectDescEn = document.getElementById('modal-project-desc-en') as HTMLTextAreaElement;
    const modalProjectImage = document.getElementById('modal-project-image') as HTMLInputElement;
    const modalProjectFallback = document.getElementById('modal-project-fallback') as HTMLInputElement;
    const modalProjectTags = document.getElementById('modal-project-tags') as HTMLInputElement;
    const modalProjectLink = document.getElementById('modal-project-link') as HTMLInputElement;
    const modalProjectDemo = document.getElementById('modal-project-demo') as HTMLInputElement;
    const modalProjectDate = document.getElementById('modal-project-date') as HTMLInputElement;

    function showModal(isEdit = false, proj: any = null) {
      if (!modal) return;
      
      if (isEdit && proj) {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-edit text-indigo-500"></i> Edit Rincian Proyek';
        modalProjectId.value = proj.id;
        modalProjectTitle.value = proj.title || '';
        modalProjectTitleEn.value = proj.title_en || '';
        modalProjectDesc.value = proj.description || '';
        modalProjectDescEn.value = proj.description_en || '';
        modalProjectImage.value = proj.image || '';
        modalProjectFallback.value = proj.fallbackImg || '';
        modalProjectTags.value = proj.tags ? proj.tags.join(', ') : '';
        modalProjectLink.value = proj.link || '';
        modalProjectDemo.value = proj.demoUrl || '';
        modalProjectDate.value = proj.date || '';
      } else {
        if (modalTitle) modalTitle.innerHTML = '<i class="fas fa-plus text-indigo-500"></i> Tambah Proyek Baru';
        modalProjectId.value = '';
        modalProjectTitle.value = '';
        modalProjectTitleEn.value = '';
        modalProjectDesc.value = '';
        modalProjectDescEn.value = '';
        modalProjectImage.value = '';
        modalProjectFallback.value = 'https://placehold.co/600x400/020617/818cf8?text=Project';
        modalProjectTags.value = '';
        modalProjectLink.value = '';
        modalProjectDemo.value = '';
        modalProjectDate.value = '';
      }

      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.add('opacity-100');
      }, 10);
    }

    function hideModal() {
      if (!modal) return;
      modal.classList.remove('opacity-100');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    document.getElementById('add-project-btn')?.addEventListener('click', () => {
      showModal(false);
    });

    document.getElementById('modal-cancel-btn')?.addEventListener('click', () => {
      hideModal();
    });

    grid?.addEventListener('click', async (e) => {
      const target = e.target as HTMLElement;
      
      const editBtn = target.closest('.edit-btn');
      if (editBtn) {
        const id = editBtn.getAttribute('data-id');
        const proj = projectsList.find(p => p.id === id);
        if (proj) {
          showModal(true, proj);
        }
        return;
      }

      const deleteBtn = target.closest('.delete-btn');
      if (deleteBtn) {
        const id = deleteBtn.getAttribute('data-id');
        if (confirm('Apakah Anda yakin ingin menghapus proyek ini secara permanen?')) {
          await deleteProject(id);
        }
        return;
      }
    });

    modalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const id = modalProjectId.value;
      const title = modalProjectTitle.value.trim();
      const title_en = modalProjectTitleEn.value.trim();
      const description = modalProjectDesc.value.trim();
      const description_en = modalProjectDescEn.value.trim();
      const image = modalProjectImage.value.trim();
      const fallbackImg = modalProjectFallback.value.trim();
      const tags = modalProjectTags.value.split(',').map(t => t.trim()).filter(t => t.length > 0);
      const link = modalProjectLink.value.trim();
      const demoUrl = modalProjectDemo.value.trim();
      const date = modalProjectDate.value.trim();

      const payload = { id, title, title_en, description, description_en, image, fallbackImg, tags, link, demoUrl, date };

      try {
        const method = id ? 'PUT' : 'POST';
        const res = await fetch('/api/projects', {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          (window as any).showToast(id ? 'Proyek berhasil diperbarui!' : 'Proyek baru ditambahkan!', 'success');
          hideModal();
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          (window as any).showToast('Gagal memproses data proyek!', 'error');
        }
      } catch (err) {
        console.error(err);
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    });

    async function deleteProject(id: string | null) {
      if (!id) return;
      try {
        const res = await fetch(`/api/projects?id=${id}`, {
          method: 'DELETE'
        });

        if (res.ok) {
          (window as any).showToast('Proyek berhasil dihapus!', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 800);
        } else {
          (window as any).showToast('Gagal menghapus proyek!', 'error');
        }
      } catch (err) {
        console.error(err);
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    }

    // ── Upload foto proyek ──
    const uploadProjectImageBtn = document.getElementById('upload-project-image-btn');
    const projectImageFileInput = document.getElementById('project-image-file-input') as HTMLInputElement;
    uploadProjectImageBtn?.addEventListener('click', () => projectImageFileInput?.click());
    projectImageFileInput?.addEventListener('change', async () => {
      const file = projectImageFileInput.files?.[0];
      if (!file) return;
      const id = modalProjectId.value;
      if (!id) {
        (window as any).showToast('Simpan proyek terlebih dahulu sebelum mengunggah gambar!', 'error');
        return;
      }
      const form = new FormData();
      form.append('projectImage', file);
      form.append('projectId', id);
      try {
        const res = await fetch('/api/upload-assets', { method: 'POST', body: form });
        const data = await res.json();
        if (data.projectImageUrl) {
          modalProjectImage.value = data.projectImageUrl;
          const preview = document.getElementById('project-image-preview') as HTMLImageElement;
          preview.src = data.projectImageUrl;
          preview.classList.remove('hidden');
          (window as any).showToast('Foto proyek berhasil diunggah!', 'success');
        } else {
          (window as any).showToast(data.error || 'Gagal mengunggah foto!', 'error');
        }
      } catch (err) {
        (window as any).showToast('Terjadi kesalahan koneksi!', 'error');
      }
    });
  </script>
</AdminLayout>

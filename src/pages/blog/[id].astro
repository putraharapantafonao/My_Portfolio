---
import fs from 'node:fs';
import path from 'node:path';
import '../../styles/global.css';

const { id } = Astro.params;

// Fetch blog data server-side
const blogs = JSON.parse(fs.readFileSync(path.resolve('src/data/blogs.json'), 'utf-8'));
const blog = blogs.find((b: any) => b.id === id);

if (!blog) {
  return Astro.redirect('/404');
}

// Fetch profile data for favicon & OG image fallbacks
const profile = JSON.parse(fs.readFileSync(path.resolve('src/data/profile.json'), 'utf-8'));

// Get language setting from cookie (default 'id')
const lang = Astro.cookies.get('lang')?.value === 'en' ? 'en' : 'id';

function getField(item: any, field: string) {
  if (lang === 'en') {
    return item[`${field}_en`] || item[field] || '';
  }
  return item[field] || '';
}

// Calculate reading time based on localized content
const contentBody = getField(blog, 'content');
const words = contentBody.split(/\s+/).length;
const readTime = Math.ceil(words / 200);

// Basic Markdown/Text to HTML parser for premium formatting
function parseContent(content: string) {
  let html = content;
  
  // Handle markdown images: ![alt](url)
  html = html.replace(/!\[(.*?)\]\((.*?)\)/g, '<img src="$2" alt="$1" class="rounded-2xl border border-slate-200 dark:border-slate-800 shadow-md my-8 max-h-96 object-cover mx-auto" />');
  
  // Handle headers
  html = html.replace(/^###\s+(.+)$/gm, '<h3 class="text-xl font-bold text-slate-900 dark:text-white mt-8 mb-4">$1</h3>');
  html = html.replace(/^##\s+(.+)$/gm, '<h2 class="text-2xl font-bold text-slate-900 dark:text-white mt-10 mb-5 pb-2 border-b border-slate-200 dark:border-slate-800">$1</h2>');
  
  // Handle bold text
  html = html.replace(/\*\*(.*?)\*\*/g, '<strong class="font-bold text-slate-900 dark:text-white">$1</strong>');
  
  // Handle lists
  const lines = html.split('\n');
  let inList = false;
  let listType = ''; // 'ul' or 'ol'
  
  for (let i = 0; i < lines.length; i++) {
    const line = lines[i].trim();
    if (line.startsWith('- ') || line.startsWith('* ')) {
      const text = line.substring(2);
      if (!inList) {
        lines[i] = '<ul class="list-disc pl-6 my-5 space-y-2">\n<li>' + text + '</li>';
        inList = true;
        listType = 'ul';
      } else {
        lines[i] = '<li>' + text + '</li>';
      }
    } else if (/^\d+\.\s+/.test(line)) {
      const match = line.match(/^\d+\.\s+(.+)$/);
      const text = match ? match[1] : '';
      if (!inList) {
        lines[i] = '<ol class="list-decimal pl-6 my-5 space-y-2">\n<li>' + text + '</li>';
        inList = true;
        listType = 'ol';
      } else {
        lines[i] = '<li>' + text + '</li>';
      }
    } else {
      if (inList) {
        lines[i-1] = lines[i-1] + `\n</${listType}>`;
        inList = false;
      }
    }
  }
  if (inList) {
    lines[lines.length - 1] = lines[lines.length - 1] + `\n</${listType}>`;
  }
  html = lines.join('\n');
  
  // Paragraph separation
  const paragraphs = html.split(/\n\s*\n/);
  const formatted = paragraphs.map(p => {
    const trimmed = p.trim();
    if (!trimmed) return '';
    if (trimmed.startsWith('<h') || trimmed.startsWith('<ul') || trimmed.startsWith('<ol') || trimmed.startsWith('<li') || trimmed.startsWith('<img')) {
      return trimmed;
    }
    return `<p class="mb-6 leading-relaxed">${trimmed.replace(/\n/g, '<br>')}</p>`;
  });
  
  return formatted.join('\n');
}

const parsedHtml = parseContent(contentBody);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href={profile.faviconUrl || "/favicon.ico"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{getField(blog, 'title')} - Blog {profile.name}</title>

    <!-- SEO & Open Graph Meta Tags for Rich Social Previews (WhatsApp, Facebook, LinkedIn, etc.) -->
    <meta name="description" content={getField(blog, 'summary')} />
    
    <meta property="og:title" content={getField(blog, 'title')} />
    <meta property="og:description" content={getField(blog, 'summary')} />
    <meta property="og:image" content={new URL(blog.image || profile.ogImageUrl || "/assets/img/foto-putra.jpeg", Astro.url).href} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={`Blog ${profile.name}`} />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={getField(blog, 'title')} />
    <meta name="twitter:description" content={getField(blog, 'summary')} />
    <meta name="twitter:image" content={new URL(blog.image || profile.ogImageUrl || "/assets/img/foto-putra.jpeg", Astro.url).href} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
    <!-- Sync theme initialization to prevent flash -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-white dark:bg-slate-950 text-slate-800 dark:text-slate-200 antialiased min-h-screen flex flex-col transition-colors duration-300">
    
    <!-- Top Nav -->
    <nav class="fixed top-0 left-0 w-full h-16 z-50 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 flex items-center transition-colors">
      <div class="max-w-3xl mx-auto px-4 w-full flex items-center justify-between">
        <a href="/" class="text-sm font-semibold text-slate-500 hover:text-indigo-600 flex items-center gap-2">
          <i class="fas fa-arrow-left"></i> <span>{lang === 'en' ? 'Back to Portfolio' : 'Kembali ke Portofolio'}</span>
        </a>
        
        <div class="flex items-center gap-3">
          <!-- Light/Dark Toggler -->
          <button id="theme-toggle" class="w-10 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-500 flex items-center justify-center cursor-pointer" aria-label="Toggle Theme">
            <i class="fas fa-sun hidden dark:inline-block"></i>
            <i class="fas fa-moon inline-block dark:hidden"></i>
          </button>

          <!-- Language Toggler -->
          <button id="lang-toggle" class="flex items-center gap-1 px-3 h-10 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-550 text-xs font-bold cursor-pointer" aria-label="Switch Language">
            <i class="fas fa-globe text-[10px] text-slate-400"></i>
            <span>{lang === 'en' ? 'EN' : 'ID'}</span>
          </button>

          <a href="/" class="text-base font-extrabold tracking-tight">
            <span class="bg-gradient-to-r from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400 text-transparent bg-clip-text">Putra</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Reading Container -->
    <main class="pt-28 pb-20 px-4 max-w-3xl mx-auto w-full flex-1">
      <article>
        <!-- Header Info -->
        <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
          <div class="flex items-center gap-3 text-xs text-slate-500 font-semibold mb-4">
            <span class="px-3 py-1 rounded-full bg-indigo-50 dark:bg-indigo-950/40 text-indigo-650 dark:text-indigo-400 border border-indigo-100 dark:border-indigo-900/20 font-bold">
              {blog.category}
            </span>
            <time datetime={blog.date}>{blog.date}</time>
            <span class="text-slate-300 dark:text-slate-700">•</span>
            <span><i class="far fa-clock"></i> {readTime} {lang === 'en' ? 'min read' : 'menit baca'}</span>
            <span class="text-slate-300 dark:text-slate-700">•</span>
            <span><i class="far fa-eye"></i> <span id="view-count">...</span> {lang === 'en' ? 'views' : 'tayangan'}</span>
          </div>

          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 dark:text-white leading-tight tracking-tight mb-4">
            {getField(blog, 'title')}
          </h1>

          <p class="text-base text-slate-500 dark:text-slate-400 italic border-l-2 border-indigo-500 pl-4">
            {getField(blog, 'summary')}
          </p>
        </header>

        {blog.image && (
          <div class="mb-10 w-full rounded-3xl overflow-hidden border border-slate-200 dark:border-slate-800 shadow-lg max-h-96">
            <img src={blog.image} alt={getField(blog, 'title')} class="w-full h-full object-cover" />
          </div>
        )}

        <!-- Article Body -->
        <div class="text-slate-600 dark:text-slate-300 text-base leading-relaxed" set:html={parsedHtml}></div>
      </article>

      <!-- Social Share Buttons -->
      <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800">
        <h3 class="text-sm font-bold text-slate-700 dark:text-slate-300 mb-4">{lang === 'en' ? 'Share this article:' : 'Bagikan artikel ini:'}</h3>
        <div class="flex gap-3">
          <a href={`https://wa.me/?text=${encodeURIComponent(getField(blog, 'title') + ' ' + Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:-translate-y-1 transition-transform shadow-md" aria-label="Share on WhatsApp">
            <i class="fab fa-whatsapp text-lg"></i>
          </a>
          <a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(getField(blog, 'title'))}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-slate-900 dark:bg-slate-700 text-white flex items-center justify-center hover:-translate-y-1 transition-transform shadow-md" aria-label="Share on X (Twitter)">
            <i class="fab fa-x-twitter text-lg"></i>
          </a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#0a66c2] text-white flex items-center justify-center hover:-translate-y-1 transition-transform shadow-md" aria-label="Share on LinkedIn">
            <i class="fab fa-linkedin-in text-lg"></i>
          </a>
          <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:-translate-y-1 transition-transform shadow-md" aria-label="Share on Facebook">
            <i class="fab fa-facebook-f text-lg"></i>
          </a>
        </div>
      </div>

      <!-- Back Footer link -->
      <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
        <a href="/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-350 hover:bg-slate-50 dark:hover:bg-slate-850 text-xs font-bold transition-all shadow-sm">
          <i class="fas fa-arrow-left"></i> {lang === 'en' ? 'Portfolio Home' : 'Beranda Portofolio'}
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer class="py-8 px-4 border-t border-slate-200 dark:border-slate-800 text-center bg-slate-50 dark:bg-slate-950 text-xs text-slate-400 dark:text-slate-500">
      <p>&copy; {new Date().getFullYear()} Putra Harapan Tafonao. Built with Astro & Tailwind.</p>
    </footer>

    <!-- Scripts -->
    <script>
      // Theme toggle
      const themeToggleBtn = document.getElementById('theme-toggle');
      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        const nextTheme = isDark ? 'dark' : 'light';
        localStorage.setItem('theme', nextTheme);
      });

      // Language toggle
      const langToggleBtn = document.getElementById('lang-toggle');
      langToggleBtn?.addEventListener('click', () => {
        const cookies = document.cookie.split('; ').reduce((acc: any, row) => {
          const parts = row.split('=');
          if (parts[0]) acc[parts[0]] = parts[1] || '';
          return acc;
        }, {});
        
        const currentLang = cookies['lang'] || 'id';
        const nextLang = currentLang === 'id' ? 'en' : 'id';
        
        document.cookie = `lang=${nextLang}; path=/; max-age=31536000; SameSite=Lax`;
        window.location.reload();
      });

      // View Counter
      const slug = window.location.pathname.split('/').filter(Boolean).pop();
      if (slug) {
        fetch('/api/views', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug })
        })
        .then(res => res.json())
        .then(data => {
          if(data.views !== undefined) {
            const countEl = document.getElementById('view-count');
            if (countEl) countEl.innerText = data.views;
          }
        })
        .catch(err => console.error('Failed to count views:', err));
      }
    </script>
  </body>
</html>